+x86_64-*-prismos*)
+	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h gnu-user.h glibc-stdint.h \
+		i386/x86-64.h i386/gnu-user-common.h i386/gnu-user64.h i386/prismos.h"
+	# An x86-64 ELF system with a deliberately Linux-shaped ABI: the stdint
+	# layout mlibc asserts (glibc-stdint.h), the GNU userspace crt sandwich
+	# and LINK_SPEC (gnu-user.h + i386/gnu-user64.h, x86_64-*-linux*'s
+	# order in config.gcc -- the generic-elf order of the first version
+	# silently dropped -shared from driver links, which no static link
+	# ever noticed until the dynamic library step), mlibc's ld.so as the
+	# dynamic linker (i386/prismos.h), and __cxa_atexit registration.
+	default_use_cxa_atexit=yes
+	;;
