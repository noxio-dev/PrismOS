+<http://www.gnu.org/licenses/>.  */
+
+/* The target macros c-family/c-cppbuiltin.cc feeds the preprocessor: an
+   ELF Unix whose userspace speaks the GNU/Linux ABI shape (i386/gnu-user64.h
+   asks for this through i386/gnu-user-common.h, the way config/linux.h
+   answers for Linux and config/gnu.h for the Hurd).  */
+#undef GNU_USER_TARGET_OS_CPP_BUILTINS
+#define GNU_USER_TARGET_OS_CPP_BUILTINS()\
+    do {\
+        builtin_define ("__prismos__");\
+        builtin_define_std ("unix");\
+        builtin_assert ("system=prismos");\
+        builtin_assert ("system=unix");\
+        builtin_assert ("system=posix");\
+    } while (0)
+
+/* The link emulations and the dynamic linker that i386/gnu-user64.h's
+   LINK_SPEC pastes into every driver link.  The dynamic linker is mlibc's
+   rtld, ld.so, at /lib/ld.so -- the path the kernel's PT_INTERP handling
+   reads from the VFS at execve (ports/toolchain/build.sh's dyn stage asks
+   for it explicitly too: a program is only as dynamic as its PT_INTERP
+   says).  */
+
+#define GNU_USER_LINK_EMULATION32 "elf_i386"
+#define GNU_USER_LINK_EMULATION64 "elf_x86_64"
+#define GNU_USER_LINK_EMULATIONX32 "elf32_x86_64"
+
+#undef GNU_USER_DYNAMIC_LINKER
+#undef GNU_USER_DYNAMIC_LINKER32
+#undef GNU_USER_DYNAMIC_LINKER64
+#undef GNU_USER_DYNAMIC_LINKERX32
+#define GNU_USER_DYNAMIC_LINKER "/lib/ld.so"
+#define GNU_USER_DYNAMIC_LINKER32 "/lib/ld.so"
+#define GNU_USER_DYNAMIC_LINKER64 "/lib/ld.so"
+#define GNU_USER_DYNAMIC_LINKERX32 "/lib/ld.so"
