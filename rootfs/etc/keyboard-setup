#!/bin/sh

# PrismOS Keyboard Setup

RESET='\033[0m'
BOLD='\033[1m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
MAGENTA='\033[35m'
WHITE='\033[37m'

clear

printf "\n${BOLD}${MAGENTA}PrismOS Keyboard Setup${RESET}\n\n"
printf "${CYAN}Choose your keyboard layout:${RESET}\n\n"

printf "${GREEN}  1.${RESET} French (AZERTY)\n"
printf "${GREEN}  2.${RESET} US English (QWERTY)\n"
printf "${GREEN}  3.${RESET} UK English (QWERTY)\n"
printf "${GREEN}  4.${RESET} German (QWERTZ)\n"
printf "${GREEN}  5.${RESET} Spanish (QWERTY)\n\n"

printf "${YELLOW}Select [1-6]: ${RESET}"
# An 8 s ceiling, not a boot blocker: the boot tests and the serial
# sessions are headless (nobody can answer here, the input queue stays
# empty), so the silence falls back to /etc/keymap -- the layout
# S10keymap already loaded -- and the boot goes on.
if read -t 8 choice; then
    case "$choice" in
        1) layout="fr" ;;
        2) layout="us" ;;
        3) layout="uk" ;;
        4) layout="de" ;;
        5) layout="es" ;;
        *)
            printf "${YELLOW}Invalid selection.${RESET}\n"
            exit 1
            ;;
    esac
else
    printf "\n${YELLOW}No answer (headless boot) -- keeping the /etc/keymap layout.${RESET}\n"
    layout=$(cat /etc/keymap 2>/dev/null)
    test -n "$layout" || layout="us"
fi

if [ ! -f "/usr/share/keymaps/$layout.bkmap" ]; then
    printf "${YELLOW}Keyboard map not found!${RESET}\n"
    exit 1
fi

loadkmap < "/usr/share/keymaps/$layout.bkmap"

if [ $? -eq 0 ]; then
    echo "KEYMAP=$layout" > /etc/keyboard.conf
    printf "\n${GREEN}Keyboard layout successfully loaded!${RESET}\n"
else
    printf "\n${YELLOW}Failed to load keyboard layout.${RESET}\n"
    exit 1
fi
