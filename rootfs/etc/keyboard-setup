# PrismOS Keyboard Setup.
# BusyBox ash + loadkmap + UTF-8 enabled.

RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'

W=50
INNER=$((W - 2))

# Build horizontal border.
hr=""
i=0
while [ "$i" -lt "$INNER" ]; do
    hr="${hr}─"
    i=$((i + 1))
done

top_line()    { printf "${CYAN}╭%s╮${RESET}\n" "$hr"; }
bottom_line() { printf "${CYAN}╰%s╯${RESET}\n" "$hr"; }
sep_line()    { printf "${CYAN}├%s┤${RESET}\n" "$hr"; }
blank()       { printf "${CYAN}│${RESET}%*s${CYAN}│${RESET}\n" "$INNER" ''; }

# Print a line with a known visible width.
# $1 = visible text width
# $2 = formatted text (may contain ANSI escapes)
# Center text using an explicitly supplied visible width.
center() {
    len=$1
    content=$2

    left=$(( (INNER - len) / 2 ))
    right=$(( INNER - len - left ))

    printf "${CYAN}│${RESET}%*s%s%*s${CYAN}│${RESET}\n" \
        "$left" "" "$content" "$right" ""
}

# Menu cell: exactly 48 visible columns inside the borders.
cell() {
    tag=$1
    description=$2

    # 2 leading spaces + 1 digit + 2 spaces
    # + description + remaining padding.
    pad=$(( INNER - 5 - ${#description} ))

    printf "${CYAN}│${RESET}  %s  %s%*s${CYAN}│${RESET}\n" \
        "$tag" "$description" "$pad" ""
}

printf "\n"

top_line
blank

center 22 "$(printf "${BOLD}${MAGENTA}PrismOS Keyboard Setup${RESET}")"
center 26 "$(printf "${DIM}Select your console keymap${RESET}")"

blank
sep_line
blank

cell "$(printf "${GREEN}1${RESET}")" "French (AZERTY)"
cell "$(printf "${GREEN}2${RESET}")" "US English (QWERTY)"
cell "$(printf "${GREEN}3${RESET}")" "UK English (QWERTY)"
cell "$(printf "${GREEN}4${RESET}")" "German (QWERTZ)"
cell "$(printf "${GREEN}5${RESET}")" "Spanish (QWERTY)"

blank
bottom_line
printf "\n"

layout=""
saved=""

while [ -z "$layout" ]; do
    printf " ${CYAN}❯${RESET} ${BOLD}Select layout [1-5]:${RESET} "

    if ! read choice; then
        printf "\n ${DIM}(no input -- keeping /etc/keymap layout)${RESET}\n"
        saved=$(cat /etc/keymap 2>/dev/null)
        test -n "$saved" || saved="us"
        layout="$saved"
        break
    fi

    case "$choice" in
        1) layout="fr" ;;
        2) layout="us" ;;
        3) layout="uk" ;;
        4) layout="de" ;;
        5) layout="es" ;;
        *) printf " ${YELLOW}✖ Invalid selection -- enter a number from 1 to 5.${RESET}\n" ;;
    esac
done

if [ ! -f "/usr/share/keymaps/$layout.bkmap" ]; then
    printf "\n ${YELLOW}✖ Keymap not found: /usr/share/keymaps/%s.bkmap${RESET}\n" "$layout"
    exit 1
fi

if loadkmap < "/usr/share/keymaps/$layout.bkmap"; then
    echo "KEYMAP=$layout" > /etc/keyboard.conf
    printf "\n ${GREEN}✔ Keyboard layout '%s' loaded successfully.${RESET}\n" "$layout"
else
    printf "\n ${YELLOW}✖ Failed to load keyboard layout '%s'.${RESET}\n" "$layout"
    exit 1
fi